# از پوشه apps/api اجرا شود. مقدارها نمونه هستند و راز نیستند.
HESABDAR_DATA_DIR=./data
HESABDAR_HOST=127.0.0.1
HESABDAR_PORT=8000
HESABDAR_MAX_UPLOAD_BYTES=31457280
HESABDAR_MAX_UNCOMPRESSED_BYTES=209715200
HESABDAR_MAX_FILES_PER_UPLOAD=20
# اگر میزبان غیر از loopback باشد این مقدار اجباری است.
# HESABDAR_ACCESS_TOKEN=
